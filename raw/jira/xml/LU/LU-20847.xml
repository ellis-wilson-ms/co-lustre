<item>
            <title>[LU-20847] lnetctl peer show of an unknown peer won&apos;t display any error</title>
                <link>https://jira.whamcloud.com/browse/LU-20847</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;Here is a test code to integrate in the fix:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
test_630() {&#160;
&#160;reinit_dlc || &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; $?&#160;
&#160;local output&#160;
&#160;local rc&#160;
&#160;output=$($LNETCTL peer show --nid 1.1.1.1@tcp 2&amp;gt;&amp;amp;1)
&#160;rc=$?&#160;
&#160;echo &lt;span class=&quot;code-quote&quot;&gt;&quot;rc=$rc output=&lt;span class=&quot;code-quote&quot;&gt;&apos;$output&apos;&lt;/span&gt;&quot;&lt;/span&gt;&#160;
&#160;((rc != 0)) || error &lt;span class=&quot;code-quote&quot;&gt;&quot;peer show of an unknown nid should fail&quot;&lt;/span&gt;&#160;
&#160;echo &lt;span class=&quot;code-quote&quot;&gt;&quot;$output&quot;&lt;/span&gt; | grep -q &lt;span class=&quot;code-quote&quot;&gt;&quot;cannot find peer&quot;&lt;/span&gt; ||&#160;
&#160; &#160; &#160; &#160; &#160;error &lt;span class=&quot;code-quote&quot;&gt;&quot;Bad or missing error message, got: &lt;span class=&quot;code-quote&quot;&gt;&apos;$output&apos;&lt;/span&gt;&quot;&lt;/span&gt;&#160;
}&#160;
run_test 630 &lt;span class=&quot;code-quote&quot;&gt;&quot;peer show: unknown peer should be reported&quot;&lt;/span&gt;&#160;&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;</description>
