                            <comment id="495242" author="bzzz" created="Fri, 29 May 2026 14:01:26 +0000"  >&lt;p&gt;I guess this should fix the problem:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
@@ -938,8 +938,8 @@ void cl_env_put(struct lu_env *env, __u16 *refcheck)
                 * with the standard tags.
                 */
                &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (cl_envs[cpu].cec_count &amp;lt; cl_envs_cached_max &amp;amp;&amp;amp;
-                   (env-&amp;gt;le_ctx.lc_tags &amp;amp; ~LCT_HAS_EXIT) == lu_context_tags_default &amp;amp;&amp;amp;
-                   (env-&amp;gt;le_ses-&amp;gt;lc_tags &amp;amp; ~LCT_HAS_EXIT) == lu_session_tags_default) {
+                   (env-&amp;gt;le_ctx.lc_tags &amp;amp; ~(LCT_HAS_EXIT|LCT_CL_INIT)) == lu_context_tags_default &amp;amp;&amp;amp;
+                   (env-&amp;gt;le_ses-&amp;gt;lc_tags &amp;amp; ~(LCT_HAS_EXIT|LCT_CL_INIT)) == lu_session_tags_default) {
                        read_lock(&amp;amp;cl_envs[cpu].cec_guard);
                        list_add(&amp;amp;cle-&amp;gt;ce_linkage, &amp;amp;cl_envs[cpu].cec_envs);
                        cl_envs[cpu].cec_count++;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
