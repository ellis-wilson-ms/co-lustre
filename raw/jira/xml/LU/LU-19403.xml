<item>
            <title>[LU-19403] llapi missing nodemap functions</title>
                <link>https://jira.whamcloud.com/browse/LU-19403</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;The llapi is seemingly missing all nodemap functions, this needs to be investigated and corrected.&lt;/p&gt;</description>
                <environment></environment>
        <key id="92387">LU-19403</key>
            <summary>llapi missing nodemap functions</summary>
