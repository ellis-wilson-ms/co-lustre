<item>
            <title>[LU-20644] lfs quota has inconsistent output for default-usr</title>
                <link>https://jira.whamcloud.com/browse/LU-20644</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;&lt;tt&gt;--default-usr&lt;/tt&gt; behaves differently than &lt;tt&gt;-U&lt;/tt&gt; for querying single limits:&lt;/p&gt;
&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;[root@node1 ~]# lfs quota --default-usr --block-hardlimit &#160;/lustre/fs/client/
Disk default usr quota:
&#160; &#160; &#160; Filesystem &#160;bquota &#160;blimit &#160;bgrace &#160;iquota &#160;ilimit &#160;igrace
/lustre/fs/client/ &#160; &#160; &#160; 0 18014398509481983 &#160; &#160; &#160; - &#160; &#160; &#160; 0 &#160; &#160; &#160; 0 &#160; &#160; &#160; -
[root@node1 ~]# lfs quota -U --block-hardlimit &#160;/lustre/fs/client/
Disk default usr quota:
&#160; blimit
18014398509481983
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;vs the project quotas:&lt;/p&gt;
&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;[root@node1 ~]# lfs quota --default-prj --block-hardlimit &#160;/lustre/fs/client/
Disk default prj quota:
&#160; blimit
18014398509481983
[root@node1 ~]# lfs quota -P --block-hardlimit &#160;/lustre/fs/client/
Disk default prj quota:
&#160; blimit
18014398509481983
 &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;or Groups:&lt;/p&gt;
&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;[root@node1 ~]# lfs quota --default-grp --block-hardlimit &#160;/lustre/fs/client/
Disk default grp quota:
&#160; blimit
0
[root@node1 ~]# lfs quota -G --block-hardlimit &#160;/lustre/fs/client/
Disk default grp quota:
&#160; blimit
0
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
