                            <comment id="494923" author="JIRAUSER22000" created="Sat, 23 May 2026 09:13:59 +0000"  >&lt;p&gt;Since somebody have some questions on this change, i studied the code a little.&lt;/p&gt;

&lt;p&gt;The old sign was initialized in cl_io_init as false&#160;&lt;/p&gt;

&lt;p&gt;&#160;&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
&#160; cl_io_init(env, io, io_type, obj)
&#160; &#160; &#160; &#9492;&#9472; coo_io_init() &#160;&lt;span class=&quot;code-comment&quot;&gt;// cl_object_operations
&lt;/span&gt;&#160; &#160; &#160; &#160; &#160; &#9492;&#9472; vvp_io_init(env, obj, io) &#160;&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;

&lt;p&gt;and set true only in read process, the code like this.&lt;/p&gt;

&lt;p&gt;&#160;&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
&lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; vvp_io_read_start(&lt;span class=&quot;code-keyword&quot;&gt;const&lt;/span&gt; struct lu_env *env,
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;&lt;span class=&quot;code-keyword&quot;&gt;const&lt;/span&gt; struct cl_io_slice *ios){
&#160; &#160; &#160; struct vvp_io *vio = cl2vvp_io(env, ios);
&#160; &#160; &#160; struct cl_io *io = ios-&amp;gt;cis_io;
&#160; &#160; &#160; struct cl_object *obj = io-&amp;gt;ci_obj;
&#160; &#160; &#160; struct inode *inode = vvp_object_inode(obj);
&#160; &#160; &#160; struct ll_inode_info *lli = ll_i2info(inode);
&#160; &#160; &#160; struct file *file = vio-&amp;gt;vui_fd-&amp;gt;fd_file;
&#160; &#160; &#160; loff_t pos = io-&amp;gt;u.ci_rd.rd.crw_pos;
&#160; &#160; &#160; size_t crw_bytes = io-&amp;gt;u.ci_rd.rd.crw_bytes;
&#160; &#160; &#160; size_t tot_bytes = vio-&amp;gt;vui_tot_bytes;
&#160; &#160; &#160; &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; result;
&#160; &#160; &#160; ENTRY;
&#160; &#160; &#160; trunc_sem_down_read(&amp;amp;lli-&amp;gt;lli_trunc_sem);
&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &#9473;&#9473;&#9473; &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; 1: async read &#9473;&#9473;&#9473;
&lt;/span&gt;&#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (io-&amp;gt;ci_async_readahead) {
&#160; &#160; &#160; &#160; &#160; file_accessed(file);
&#160; &#160; &#160; &#160; &#160; RETURN(0); &#160;&lt;span class=&quot;code-comment&quot;&gt;// &#8592; vui_ra_valid remains &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;
&lt;/span&gt;&#160; &#160; &#160; }
&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &#9473;&#9473;&#9473; &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; 2: Layout change&#160; &#9473;&#9473;&#9473;
&lt;/span&gt;&#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (!can_populate_pages(env, io, inode))
&#160; &#160; &#160; &#160; &#160; RETURN(0); &#160;&lt;span class=&quot;code-comment&quot;&gt;// &#8592; vui_ra_valid remains &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;
&lt;/span&gt;&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &#9473;&#9473;&#9473; &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; 3: LRU preserve failed&#160; &#9473;&#9473;&#9473;
&lt;/span&gt;&#160; &#160; &#160; flags = iocb_ki_flags_get(file, vio-&amp;gt;vui_iocb);
&#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (!iocb_ki_flags_check(flags, DIRECT)) {
&#160; &#160; &#160; &#160; &#160; result = cl_io_lru_reserve(env, io, pos, crw_bytes);
&#160; &#160; &#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (result)
&#160; &#160; &#160; &#160; &#160; &#160; &#160; RETURN(result); &#160;&lt;span class=&quot;code-comment&quot;&gt;// &#8592; vui_ra_valid remains &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;
&lt;/span&gt;&#160; &#160; &#160; }
&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &#9473;&#9473;&#9473; erturn 4: filesize check&#160; &#9473;&#9473;&#9473;
&lt;/span&gt;&#160; &#160; &#160; result = vvp_prep_size(env, obj, io, pos, crw_bytes, &amp;amp;exceed);
&#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (result != 0)
&#160; &#160; &#160; &#160; &#160; RETURN(result); &#160;&lt;span class=&quot;code-comment&quot;&gt;// &#8592; vui_ra_valid remains &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;
&lt;/span&gt;&#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;else&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (exceed != 0)
&#160; &#160; &#160; &#160; &#160; GOTO(out, result); &#160;&lt;span class=&quot;code-comment&quot;&gt;// &#8592; vui_ra_valid remains &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;
&lt;/span&gt;&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &#9473;&#9473;&#9473; set &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;&#160; &#9473;&#9473;&#9473;
&lt;/span&gt;&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;/* initialize read-ahead window once per syscall */&lt;/span&gt;
&#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (!vio-&amp;gt;vui_ra_valid) {
&#160; &#160; &#160; &#160; &#160; vio-&amp;gt;vui_ra_valid = &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;; &#160;&lt;span class=&quot;code-comment&quot;&gt;// vui_ra_valid set &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;
&lt;/span&gt;&#160; &#160; &#160; &#160; &#160; vio-&amp;gt;vui_ra_start_idx = pos &amp;gt;&amp;gt; PAGE_SHIFT;
&#160; &#160; &#160; &#160; &#160; vio-&amp;gt;vui_ra_pages = 0;
&#160; &#160; &#160; &#160; &#160; page_offset = pos &amp;amp; ~PAGE_MASK;
&#160; &#160; &#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (page_offset) {
&#160; &#160; &#160; &#160; &#160; &#160; &#160; vio-&amp;gt;vui_ra_pages++;
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (tot_bytes &amp;gt; PAGE_SIZE - page_offset)
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; tot_bytes -= (PAGE_SIZE - page_offset);
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;else&lt;/span&gt;
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; tot_bytes = 0;
&#160; &#160; &#160; &#160; &#160; }
&#160; &#160; &#160; &#160; &#160; vio-&amp;gt;vui_ra_pages += (tot_bytes + PAGE_SIZE - 1) &amp;gt;&amp;gt; PAGE_SHIFT;
&#160; &#160; &#160; &#160; &#160; CDEBUG(D_READA, &lt;span class=&quot;code-quote&quot;&gt;&quot;tot %zu, ra_start %lu, ra_count %lu\n&quot;&lt;/span&gt;,
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;vio-&amp;gt;vui_tot_bytes, vio-&amp;gt;vui_ra_start_idx,
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;vio-&amp;gt;vui_ra_pages);
&#160; &#160; &#160; }
&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &#9473;&#9473;&#9473; actually&#160; I/O (&#31532; 892 &#34892;) &#9473;&#9473;&#9473;
&lt;/span&gt;&#160; &#160; &#160; result = generic_file_read_iter(vio-&amp;gt;vui_iocb, &amp;amp;iter);
&#160; &#160; &#160; &lt;span class=&quot;code-comment&quot;&gt;// &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt; will cause page_fault &#8594; ll_readpage() &#8594; ll_io_read_page()
&lt;/span&gt;&#160; &#160; &#160; ......
}
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;

&lt;p&gt;as we can see, if vio-&amp;gt;vui_ra_valid remains false, it won&apos;t trigger ll_io_read_page().&#160;&lt;/p&gt;

&lt;p&gt;This means when in ll_io_read_page(), if the sign is true, it will no doubtly comes from a REAL read.&lt;/p&gt;

&lt;p&gt;But if the sign is false, it will comes from Not only mmap, but also a normal write with page fault.&lt;/p&gt;

&lt;p&gt;Regarding a write as a mmap won&apos;t affect this function&apos;s correctness, because ll_io_read_page() still will grab the page,&#160;&lt;/p&gt;

&lt;p&gt;but it may cause more RPCs as a mmap, miscalculate the statistic info and affect the RAS policy.&#160;&lt;/p&gt;

&lt;p&gt;So the change is more precise.&lt;/p&gt;</comment>
