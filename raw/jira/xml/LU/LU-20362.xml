                            <comment id="496286" author="lixi_wc" created="Wed, 17 Jun 2026 02:09:11 +0000"  >&lt;p&gt;&lt;a href=&quot;https://jira.whamcloud.com/secure/ViewProfile.jspa?name=xiwang&quot; class=&quot;user-hover&quot; rel=&quot;xiwang&quot;&gt;xiwang&lt;/a&gt; Please take a look.&lt;/p&gt;</comment>
                            <comment id="496296" author="JIRAUSER22000" created="Wed, 17 Jun 2026 12:49:18 +0000"  >&lt;p&gt;using strace to analysis the system call, and we can see&lt;/p&gt;

&lt;p&gt;on Rocky9&apos;s client, ls invokes readlink, and returns ERPOTO as expected&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
futex(0x7fec6dbfba8c, FUTEX_WAKE_PRIVATE, 2147483647) = 0
statx(AT_FDCWD, &lt;span class=&quot;code-quote&quot;&gt;&quot;/mnt/lustre/test_17i_dir/testlink&quot;&lt;/span&gt;, AT_STATX_SYNC_AS_STAT|AT_SYMLINK_NOFOLLOW|AT_NO_AUTOMOUNT, STATX_MODE|STATX_NLINK|STATX_UID|STATX_GID|STATX_MTIME|STATX_SIZE, {stx_mask=STATX_MODE|STATX_NLINK|STATX_UID|STATX_GID|STATX_MTIME|STATX_SIZE|STATX_MNT_ID, stx_attributes=0, stx_mode=S_IFLNK|0777, stx_size=33, ...}) = 0
lgetxattr(&lt;span class=&quot;code-quote&quot;&gt;&quot;/mnt/lustre/test_17i_dir/testlink&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;security.selinux&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;unconfined_u:object_r:unlabeled_&quot;&lt;/span&gt;..., 255) = 37
access(&lt;span class=&quot;code-quote&quot;&gt;&quot;/&lt;span class=&quot;code-keyword&quot;&gt;var&lt;/span&gt;/run/setrans/.setrans-unix&quot;&lt;/span&gt;, F_OK) = -1 ENOENT (&#27809;&#26377;&#37027;&#20010;&#25991;&#20214;&#25110;&#30446;&#24405;)
futex(0x7fec6dc8a520, FUTEX_WAKE_PRIVATE, 2147483647) = 0
readlink(&lt;span class=&quot;code-quote&quot;&gt;&quot;/mnt/lustre/test_17i_dir/testlink&quot;&lt;/span&gt;, 0x55ce6be7d1c0, 34) = -1 EPROTO (&#21327;&#35758;&#38169;&#35823;) &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;while on Ubuntu26&#8216;s client, ls first invokes listxattr, which consumed EPROTO error,&lt;/p&gt;

&lt;p&gt;and return ok when it really calls readlink.&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
listxattr(&lt;span class=&quot;code-quote&quot;&gt;&quot;/mnt/lustre/test_17i_dir/testlink&quot;&lt;/span&gt;, 0x7ffcd8062e50, 4096) = -1 EPROTO (Protocol error)
listxattr(&lt;span class=&quot;code-quote&quot;&gt;&quot;/mnt/lustre/test_17i_dir/testlink&quot;&lt;/span&gt;, 0x7ffcd8062f60, 4096) = -1 ENOENT (No such file or directory)
......
readlink(&lt;span class=&quot;code-quote&quot;&gt;&quot;/etc/localtime&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;/usr/share/zoneinfo/Asia/Shangha&quot;&lt;/span&gt;..., 256) = 33 &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;So, it may be an easy way to replace &quot;ls -l&quot; with &quot;readlink&quot; in sanity.sh test_17i?&lt;/p&gt;</comment>
