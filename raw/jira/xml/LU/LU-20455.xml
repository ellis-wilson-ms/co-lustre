<item>
            <title>[LU-20455] Split test suites into individual files by test case</title>
                <link>https://jira.whamcloud.com/browse/LU-20455</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;We should not have mega 10000+ line shell scripts. Instead, split test suites into individual files by test case. This will be easier to read and will reduce the number of potential merge conflicts.&lt;/p&gt;</description>
                <environment></environment>
