                            <comment id="497438" author="JIRAUSER20601" created="Wed, 8 Jul 2026 02:44:32 +0000"  >&lt;p&gt;my test program is as follows:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
#include &amp;lt;sys/types.h&amp;gt;
#include &amp;lt;grp.h&amp;gt;
#include &amp;lt;stdio.h&amp;gt;
&lt;span class=&quot;code-object&quot;&gt;char&lt;/span&gt; buf[4096];
&lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt;
main(void)
{
        struct group grp, *pgrp;
        &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; rc;
        rc = getgrgid_r(1001, &amp;amp;grp, buf, sizeof(buf), &amp;amp;pgrp);
        &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (rc == 0 &amp;amp;&amp;amp; pgrp) {
                printf(&lt;span class=&quot;code-quote&quot;&gt;&quot;rc=%d grp_name=%s\n&quot;&lt;/span&gt;, rc, grp.gr_name); 
                printf(&lt;span class=&quot;code-quote&quot;&gt;&quot;buf=%p grp_name=%p\n&quot;&lt;/span&gt;, buf, grp.gr_name);
        }
        &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; rc;
}
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;

&lt;p&gt;the output on my system is as follows:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
root@vhost31:~# ./a.out
rc=0 grp_name=quota_usr
buf=0x5b2fd9a01040 grp_name=0x5b2fd9a01050&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;

&lt;p&gt;if /usr/lib/systemd/system/unscd.service is stopped, pgrp-&amp;gt;gr_name == &amp;amp;buf&lt;span class=&quot;error&quot;&gt;&amp;#91;0&amp;#93;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
root@vhost31:~# systemctl stop unscd
root@vhost31:~# ./a.out
rc=0 grp_name=quota_usr
buf=0x62edd7c6a040 grp_name=0x62edd7c6a040&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
                            <comment id="497440" author="JIRAUSER20601" created="Wed, 8 Jul 2026 02:48:16 +0000"  >&lt;p&gt;A possible fix may be as follows:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
&lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; uid2name(&lt;span class=&quot;code-object&quot;&gt;char&lt;/span&gt; *name, size_t name_max, __u32 id)
{
...
        &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (passwd-&amp;gt;pw_name != name) 
                memmove(name, passwd-&amp;gt;pw_name, strlen(passwd-&amp;gt;pw_name) + 1); 
        &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; 0; 
}
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
&lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; inline &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; gid2name(&lt;span class=&quot;code-object&quot;&gt;char&lt;/span&gt; *name, size_t name_max, __u32 id)
{
...
&#160; &#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (group-&amp;gt;gr_name != name)
&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; memmove(name, group-&amp;gt;gr_name, strlen(group-&amp;gt;gr_name) + 1);
  &#160; &#160; &#160; &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; 0;
} &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
