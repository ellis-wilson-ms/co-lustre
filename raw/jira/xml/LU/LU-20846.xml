<item>
            <title>[LU-20846]  ll_file_open() double-unlocks lli_och_mutex when pcc_file_open() failed</title>
                <link>https://jira.whamcloud.com/browse/LU-20846</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
    mutex_unlock(&amp;amp;lli-&amp;gt;lli_och_mutex);
    &lt;span class=&quot;code-comment&quot;&gt;/* It is not from atomic_open(). */&lt;/span&gt;
    &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (it == &amp;amp;oit) {
        rc = pcc_file_open(inode, file);
        &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (rc)
            GOTO(out_och_free, rc);
    }
...
out_och_free:
    &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (rc) {
        &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (och_p &amp;amp;&amp;amp; *och_p) {
            OBD_FREE(*och_p, sizeof(struct obd_client_handle));
            *och_p = NULL; &lt;span class=&quot;code-comment&quot;&gt;/* OBD_FREE writes some magic there */&lt;/span&gt;
            (*och_usecount)--;
        }
        mutex_unlock(&amp;amp;lli-&amp;gt;lli_och_mutex); &lt;span class=&quot;code-comment&quot;&gt;// unlock again!&lt;/span&gt;&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;Found by graph-hunter-v1&lt;/p&gt;</description>
